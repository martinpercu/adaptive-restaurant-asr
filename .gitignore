# --- ARS gitignore ---
# Secrets
.env
.env.*
!.env.example

# Data / models / reports are gitignored except manifests & READMEs
data/**
!data/**/
!data/**/manifest.parquet
!data/**/manifest.json
!data/**/dataset.json
!data/**/README.md
!data/**/*.license

models/**
!models/
!models/registry.json
# classifier eval report is small text evidence (showcase) — weights stay ignored
!models/noise_classifier/
!models/noise_classifier/**/
!models/noise_classifier/**/eval.json

# reports/ are gitignored EXCEPT the light text/image evidence (this repo is a public
# showcase — see DECISIONS 2026-07-18). Heavy data (*.parquet) stays out.
reports/**
!reports/**/
!reports/**/*.md
!reports/**/*.json
!reports/**/*.png
!reports/**/*.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.uv/
.python-version.local

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# OS / editors
.DS_Store
*.swp
.idea/
.vscode/
