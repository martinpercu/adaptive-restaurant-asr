# ARS environment variables — copy to .env and fill in.
# .env is gitignored; never commit real keys.

# LLM-as-a-Judge providers (phase 6+). Only the configured provider's key is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: S3-compatible storage (MinIO). Leave unset to use LocalStorage.
# ARS_S3_ENDPOINT=http://localhost:9000
# ARS_S3_ACCESS_KEY=minioadmin
# ARS_S3_SECRET_KEY=minioadmin
# ARS_S3_BUCKET=ars

# Optional: override any Settings field with the ARS_ prefix and __ nesting,
# e.g. ARS_VAD__MIN_SPEECH_RATIO=0.25
