# ARS CPU image — inference + tooling (plan/phases/phase-0 §0.4).
FROM python:3.12-slim

# System deps: ffmpeg (audio decode) + libsndfile (soundfile).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libsndfile1 make git \
    && rm -rf /var/lib/apt/lists/*

# uv for fast, reproducible installs.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock* README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev || uv sync

COPY . .
ENV ARS_ASR__DEVICE=cpu ARS_ASR__COMPUTE_TYPE=int8
EXPOSE 8000
CMD ["uv", "run", "uvicorn", "ars.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
